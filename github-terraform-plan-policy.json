{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TerraformStateBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::aws-lab-tfstate-984774734569-apne1",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "aws-lab",
            "aws-lab/*"
          ]
        }
      }
    },
    {
      "Sid": "TerraformStateObject",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::aws-lab-tfstate-984774734569-apne1/aws-lab/terraform.tfstate"
    },
    {
      "Sid": "TerraformStateLock",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::aws-lab-tfstate-984774734569-apne1/aws-lab/terraform.tfstate.tflock"
    },
    {
      "Sid": "TerraformReadOnlyEC2",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSubnets",
        "ec2:DescribeVpcs",
        "ec2:DescribeImages",
        "ec2:DescribeVpcAttribute"
      ],
      "Resource": "*"
    },
    {
      "Sid": "TerraformReadOnlyIAM",
      "Effect": "Allow",
      "Action": [
        "iam:GetInstanceProfile"
      ],
      "Resource": "arn:aws:iam::984774734569:instance-profile/aws-lab-ec2-ssm-profile"
    },
    {
      "Sid": "TerraformReadOnlyLogs",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups",
        "logs:ListTagsForResource"
      ],
      "Resource": "*"
    }
  ]
}
